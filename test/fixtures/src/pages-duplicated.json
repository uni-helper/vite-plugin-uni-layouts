    // #ifdef H5 || MP-WEIXIN
    {
      "path": "pages/index/index",
      "layout": "kebabLayout"
    },
    // #endif
    // #ifdef MP-WEIXIN
    {
      "path": "pages/index/index",
      "layout": "camelLayout"
    }
    // #endif
  ]
}
