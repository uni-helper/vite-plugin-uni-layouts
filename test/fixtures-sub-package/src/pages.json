        // #ifdef H5
        {
          "path": "list/index",
          "layout": "web"
        },
        // #endif
        // #ifdef MP-WEIXIN
        {
          "path": "list/index",
          "layout": false
        },
        // #endif
        // #ifdef H5
        {
          "path": "list/named",
          "layout": "web"
        },
        // #endif
        // #ifdef MP-WEIXIN
        {
          "path": "list/named",
          "layout": "tabbar"
        }
        // #endif
      ]
    }
  ]
}
