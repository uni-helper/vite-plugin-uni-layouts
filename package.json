{
  "name": "@uni-helper/vite-plugin-uni-layouts",
  "type": "module",
  "version": "0.1.11",
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "warn"
    }
  },
  "description": "Customizable layouts framework for uni-app applications using Vite.",
  "author": "KeJun",
  "license": "MIT",
  "homepage": "https://github.com/uni-helper/vite-plugin-uni-layouts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/vite-plugin-uni-layouts.git"
  },
  "bugs": "https://github.com/uni-helper/vite-plugin-uni-layouts/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "client.d.ts",
    "dist"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "build:play:h5": "pnpm -C playground run build:h5",
    "build:play:mp-weixin": "pnpm -C playground run build:mp-weixin",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build",
    "release": "bumpp",
    "dev:play:h5": "pnpm -C playground run dev:h5",
    "dev:play:mp-weixin": "pnpm -C playground run dev:mp-weixin",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/types": "catalog:",
    "@uni-helper/uni-env": "catalog:",
    "@vue/compiler-core": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "ast-kit": "catalog:",
    "chokidar": "catalog:",
    "jsonc-parser": "catalog:",
    "magic-string": "catalog:",
    "scule": "catalog:",
    "tinyglobby": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
